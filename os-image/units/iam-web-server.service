[Unit]
Description=IAM-OS web server (launcher + games + control API)
Documentation=https://github.com/clubeedg-ship-it/iam-os
After=iam-touch-bridge.service network.target
Requires=iam-touch-bridge.service

[Service]
Type=simple
User=iam-os
Group=iam-os
WorkingDirectory=/opt/iam-os/services/web-server
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/iam-os/services/web-server/.venv/bin/python -m iam_webserver
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
